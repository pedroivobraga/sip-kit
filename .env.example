# sip-kit configuration

# Local IP to bind (0.0.0.0 for all interfaces)
SIP_LOCAL_IP=0.0.0.0

# External/public IP (used in SDP, Via headers, ICE candidates)
# If not set, auto-detected from network interfaces
SIP_EXTERNAL_IP=

# SIP listening port
SIP_PORT=5060

# RTP port range for media relay (must be even numbers)
RTP_PORT_MIN=10000
RTP_PORT_MAX=10100

# Path to server configuration file
SIP_CONFIG_PATH=./config/servers.json

# STUN server (optional, for client configuration)
STUN_SERVER=stun:stun.l.google.com:19302

# Enable verbose logging
SIP_VERBOSE=true
